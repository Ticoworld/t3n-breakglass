# Copy this file to .env.bootstrap for the one-time operator bootstrap.
# Do not use .env.bootstrap when invoking the contract.
# T3N API key from the Terminal 3 claim page.
T3N_API_KEY=

# Fine-grained GitHub PAT, restricted to the disposable repository with
# Administration: read/write. The invoke path never reads this variable.
GITHUB_PAT=

# Disposable GitHub target. The Rust contract is rebuilt with these values before registration.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DEPLOY_KEY_ID=

# The replacement agent key is provisioned by T3N and must never be shared
# with the operator/bootstrap process. Copy these into .env.replacement-agent
# locally; do not commit that file.
REPLACEMENT_AGENT_T3N_API_KEY=
REPLACEMENT_AGENT_DID=
REPLACEMENT_AGENT_ORGANISATION_DID=
