# OPERATOR / CONTROL PLANE ONLY
# Copy the operator/GitHub values in this section to .env.bootstrap.
# Never use .env.bootstrap when invoking the agent.
# T3N API key from the Terminal 3 claim page.
T3N_API_KEY=

# Fine-grained GitHub PAT, restricted to the disposable repository with
# Administration: read/write. The invoke path never reads this variable.
GITHUB_PAT=

# Fresh bootstrap target. setup-github validates this private repository and
# creates/verifies one read-only disposable key. The Rust contract pins only
# the GitHub host; owner/repository/key are frozen later in the private
# Incident Authority, not compiled into the contract.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DEPLOY_KEY_ID=

# AGENT / EXECUTION PLANE ONLY
# Copy these values to .env.replacement-agent. Do not copy them to
# .env.bootstrap, and do not commit either file.
REPLACEMENT_AGENT_T3N_API_KEY=
REPLACEMENT_AGENT_DID=
REPLACEMENT_AGENT_ORGANISATION_DID=
