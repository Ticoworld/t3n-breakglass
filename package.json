{
  "name": "t3n-breakglass",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run winner:test",
    "winner:build": "node --import tsx winner/scripts/build-contract.ts",
    "winner:test": "node --import tsx --test --test-concurrency=1 winner/tests/w1-*.test.ts",
    "breakglass:doctor": "node --env-file-if-exists=.env.winner.coordinator node_modules/tsx/dist/cli.mjs winner/runtime/doctor.ts",
    "breakglass:start": "node --env-file-if-exists=.env.winner.coordinator node_modules/tsx/dist/cli.mjs winner/runtime/start.ts",
    "breakglass:broker": "node --env-file-if-exists=.env.winner.broker node_modules/tsx/dist/cli.mjs winner/runtime/broker.ts",
    "breakglass:inspect": "node --env-file-if-exists=.env.winner.coordinator node_modules/tsx/dist/cli.mjs winner/runtime/inspect.ts",
    "breakglass:policy:create": "node --env-file-if-exists=.env.winner.coordinator node_modules/tsx/dist/cli.mjs winner/runtime/policy-create.ts",
    "breakglass:policy:retire": "node --env-file-if-exists=.env.winner.coordinator node_modules/tsx/dist/cli.mjs winner/runtime/policy-retire.ts"
  },
  "dependencies": {
    "@terminal3/t3n-sdk": "5.2.0",
    "tsx": "4.20.5"
  }
}
